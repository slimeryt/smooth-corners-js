{
  "name": "smooth-corners-solid",
  "version": "0.2.0",
  "description": "Smooth (continuous-curvature) corners for SolidJS. A use: directive and an app-wide helper.",
  "keywords": [
    "solid",
    "solidjs",
    "smooth corners",
    "squircle",
    "border-radius",
    "continuous corners"
  ],
  "license": "MIT",
  "author": "slimeryt",
  "homepage": "https://slimeryt.github.io/smooth-corners-js/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slimeryt/smooth-corners-js.git",
    "directory": "packages/solid"
  },
  "bugs": {
    "url": "https://github.com/slimeryt/smooth-corners-js/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "smooth-corners-js": "^0.2.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "solid-js": "^1.9.0"
  },
  "peerDependencies": {
    "solid-js": "^1.0.0"
  }
}
