{
  "name": "smooth-corners-svelte",
  "version": "0.1.0",
  "description": "Smooth (continuous-curvature) corners for Svelte. A use: action that works in Svelte 3, 4 and 5.",
  "keywords": [
    "svelte",
    "sveltekit",
    "smooth corners",
    "squircle",
    "border-radius",
    "continuous corners"
  ],
  "license": "MIT",
  "author": "slimeryt",
  "homepage": "https://slimeryt.github.io/smooth-corners-js/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slimeryt/smooth-corners-js.git",
    "directory": "packages/svelte"
  },
  "bugs": {
    "url": "https://github.com/slimeryt/smooth-corners-js/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "smooth-corners-js": "^0.1.2"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
