{
  "name": "smooth-corners-element",
  "version": "0.1.0",
  "description": "A <smooth-corners> web component with continuous-curvature corners. Works in any framework or none.",
  "keywords": [
    "web component",
    "custom element",
    "smooth corners",
    "squircle",
    "border-radius",
    "continuous corners"
  ],
  "license": "MIT",
  "author": "slimeryt",
  "homepage": "https://slimeryt.github.io/smooth-corners-js/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slimeryt/smooth-corners-js.git",
    "directory": "packages/element"
  },
  "bugs": {
    "url": "https://github.com/slimeryt/smooth-corners-js/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/define.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "default": "./dist/define.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "smooth-corners-js": "^0.1.2"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
